# In Progress Backend Environment Configuration
PORT=5002

# MongoDB Atlas Connection URI (Replace with your actual MongoDB Atlas cluster credentials)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/in_progress?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/in_progress?retryWrites=true&w=majority

# Allowed Frontend Origins for CORS (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:5174,http://localhost:5173
